---
/**
 * /mapa — full-screen interactive weather map.
 *
 * The MapLibre bootstrap, layer state machine, shaders, and DOM wiring
 * live in:
 *   src/lib/interactive-map.ts       — factory function
 *   src/components/InteractiveMap.astro — Astro wrapper + markup
 *
 * This page is the canonical "all features on" consumer. The same component
 * is also embedded on the home and forecast pages with reduced features.
 *
 * Story 21.2 — /mapa opens on the GeoColor satellite layer and, once the
 * first frame has tiles, plays the last 3 h on its own (bootAutoplay); a
 * hash `layer=` still wins, a hash without one keeps satellite. The home
 * embed keeps radar and the /mapa/<capa>/ pages keep their own layer.
 *
 * IDs preserved here (#map, #mapq, #mapac, #layerbtn-*, #opacity, #legend,
 * #timeline, #tl-prev/play/next/range/time, #mapmsg) — the e2e suite in
 * e2e/mapa.spec.ts depends on them, and the ?e2e=1 affordance sets
 * window.__map only on this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import InteractiveMap from '../components/InteractiveMap.astro';
import SmnAvisos from '../components/SmnAvisos.astro';

const lang = 'es' as const;
const t = ui[lang];
---

{/* Story 22.5 — feedbackPlacement="nav": the site-wide report button
    sits in the nav bar here instead of floating over the full-screen map
    (plan PARIDAD_VISUAL §1.2 chrome budget), as the home puts it in the
    footer so it never covers the embed. */}
<BaseLayout title={`${t.map_title} — Clima México 🇲🇽`} description={t.map_teaser_heading} lang={lang} noFooter feedbackPlacement="nav">
  {/* Subtract nav height so the map fills the rest of the viewport
      exactly, no vertical scrollbar (plan P2.2). Nav is h-12 mobile,
      h-14 sm+. */}
  <main class="relative h-[calc(100dvh-3rem)] sm:h-[calc(100dvh-3.5rem)] w-full overflow-hidden bg-gray-100 dark:bg-gray-950">
    {/* sr-only h1 — the full-screen map has no room for a visible
        title, but every page needs an h1 for SEO + assistive tech.
        document.title already carries the same string for sighted
        users. */}
    <h1 class="sr-only" data-i18n-en="Interactive weather map of Mexico">
      {t.map_title}
    </h1>
    <InteractiveMap
      mapId="map"
      height="100%"
      initialView={{ lat: 23.6, lng: -102.5, zoom: 4.5 }}
      initialLayer="satellite"
      bootAutoplay={true}
      framePrefetch={true}
      features={{
        layerRail: true,
        timeline: true,
        search: true,
        locateButton: true,
        presetPins: true,
        backLink: true,
        /* Story 22.3 — zoom by scroll/pinch/keys; no +/− buttons. */
        gestureZoomOnly: true,
        /* Only the full-page map gets the mobile controls panel — the
           homepage teaser sets layerRail too, and a 400px embed has no
           room for it (Story 11.3). */
        mobileControls: true,
        /* Story 22.5 — chrome budget (≤ 8 desktop / ≤ 5 phone, plan
           PARIDAD_VISUAL §1.2): the rail starts folded to its tab bar and
           the timeline's step buttons show on hover/focus (with the
           Controles panel on a phone). /mapa only. */
        compactChrome: true,
        /* Granular chrome flags — /mapa is the "all on" consumer. The
           home embed leaves these off (see index.astro). */
        tools: true,
        settings: true,
        info: true,
        modelToggle: true,
        coords: true,
        legend: true,
        welcome: true,
      }}
      useHash={true}
      exposeE2eHook={true}
      lazy={false}
      lang={lang}
    >
      {/* Story 22.4 — SMN avisos counter in the top bar, left of search.
          Replaces the always-on amber <details> pill that floated in the
          bottom-right corner: the counter ships [hidden] and shows only
          when the feed has at least one aviso (every state plus the
          national bucket, deduped — the same allAvisos() list the panel
          renders with scope="all"), red when one is critical. It opens
          the same <SmnAvisos> widget in a popover hanging from the
          search row (#mapa-smn-panel keeps the old panel's id; the print
          stylesheet hides it). Wired by src/lib/map/chrome/smn-counter.ts
          from the script below. */}
      <Fragment slot="topbar">
        <button
          id="mapa-smn-btn"
          type="button"
          hidden
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="mapa-smn-panel"
          aria-label="Avisos SMN"
          title="Avisos SMN"
          data-severity="info"
          class="group/smn flex h-11 min-w-11 items-center justify-center gap-1 rounded-full bg-gray-900/80 px-3 text-sm font-semibold tabular-nums text-white shadow-lg backdrop-blur-sm hover:bg-gray-900/95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 aria-expanded:ring-2 aria-expanded:ring-amber-400/70 data-[severity=critical]:bg-red-600/90 data-[severity=critical]:hover:bg-red-600"
        >
          <span aria-hidden="true" class="text-base leading-none text-amber-400 group-data-[severity=critical]/smn:text-white">⚠&#xFE0E;</span>
          <span id="mapa-smn-count"></span>
        </button>
        <div
          id="mapa-smn-panel"
          role="dialog"
          aria-label="Avisos SMN"
          data-i18n-en-aria-label="SMN alerts"
          tabindex="-1"
          hidden
          class="im-reveal absolute right-0 top-14 max-h-[min(60vh,32rem)] w-[min(380px,calc(100vw-1.5rem))] overflow-y-auto rounded-lg text-start shadow-xl focus:outline-none"
        >
          <SmnAvisos scope="all" />
        </div>
      </Fragment>
    </InteractiveMap>
  </main>

  <script>
    // Story 22.4 — the top-bar counter. <SmnAvisos scope="all"> renders
    // the panel's content on its own; this only fills the counter (same
    // memoised fetch, one request) and wires the popover.
    import { loadSmnAvisos } from '../lib/smn-avisos';
    import {
      applySmnCounter,
      smnCounterState,
      wireSmnCounter,
    } from '../lib/map/chrome/smn-counter';
    const base = (() => {
      const b = (import.meta.env.BASE_URL as string) || '/';
      return b.endsWith('/') ? b : b + '/';
    })();

    const button = document.getElementById('mapa-smn-btn');
    const panel = document.getElementById('mapa-smn-panel');
    if (button && panel) {
      const els = {
        button,
        panel,
        countEl: document.getElementById('mapa-smn-count'),
      };
      wireSmnCounter(els);
      const lang =
        document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'es';
      void loadSmnAvisos(base).then((doc) => {
        applySmnCounter(els, smnCounterState(doc), lang);
      });
    }
  </script>
</BaseLayout>
