---
/**
 * IconSprite — inline SVG <symbol> sheet for the UI iconography.
 *
 * Rendered once per page (BaseLayout, right after <body>) so any markup
 * or runtime DOM can draw an icon with
 *   <svg class="h-5 w-5" aria-hidden="true"><use href="#i-radar"/></svg>
 * Monochrome, 24×24, stroke-based (currentColor) so the same glyph reads
 * on light chips, dark chips and the map. Replaces the emoji that used
 * to serve as icons (🗺️🌧️📡🌡️💧🧭💨☀️ 🔍📍⚙️ℹ️📏📐📸👁 ⚠️⭐➕), which
 * rendered as a different coloured picture on every OS.
 *
 * Ids: `i-<name>`. Names are what `LayerDef.icon` (src/lib/maplayers.ts)
 * and the chrome reference; `src/lib/maplayers.test.ts` asserts every
 * layer icon exists here.
 *
 * Paths are the ISC-licensed Lucide glyphs (https://lucide.dev).
 */
const icons: Record<string, string> = {
  map: '<path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>',
  radar: '<path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M16 14v6"/><path d="M8 14v6"/><path d="M12 16v6"/>',
