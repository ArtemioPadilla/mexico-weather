---
/**
 * InteractiveMap — Reusable wrapper around the full MapLibre experience
 * (basemap, search, layer rail, opacity slider, legend, timeline,
 * preset/user pins, dark-mode swap, terminator overlay, etc.).
 *
 * Used by:
 *   /mapa      — full-screen (all features on)
 *   /          — 400px embed (layer rail + timeline + preset pins)
 *
 * NOT used by /forecast: that page calls initInteractiveMap() directly from
 * its own client script (src/pages/forecast.astro), so it gets none of this
 * component's boot scheduling, double-init guard or lazy IntersectionObserver
 * path. That is why the #289 rAF→setTimeout fix had to be applied there
 * separately (issue #124).
 *
 * Each instance owns a uniquely-prefixed set of IDs (mapId="map" stays
 * stable for /mapa to preserve e2e selectors and the ?e2e=1 affordance).
 */
import { ui } from '../i18n/ui';
import type { InteractiveMapFeatures } from '../lib/interactive-map';

/** Single source of truth for the feature flags lives in
 *  src/lib/interactive-map.ts (InteractiveMapFeatures). This Astro
 *  wrapper only adds the two flags that are pure markup here. */
interface Features extends InteractiveMapFeatures {
  backLink?: boolean;
  /** Below sm, reveal the rail's tab bar (Capas / Superposiciones) and
   *  active-layer block (sub-options + opacity, Story 22.2) and the model
   *  toggle behind one trigger (Story 11.3; the measure/snapshot tools
   *  moved to the ⋯ menu in Story 22.3). Deliberately NOT keyed off layerRail: the homepage
   *  teaser sets that too, and a 400px embed has no room for the panel.
   *  Only the full-page /mapa should set this. */
  mobileControls?: boolean;
  /** Story 22.5 — the chrome budget of plan PARIDAD_VISUAL §1.2 (≤ 8
   *  controls over the map on desktop, ≤ 5 on a phone). The rail starts
   *  collapsed to its Capas / Superposiciones tab bar (a tab opens it);
   *  the timeline's step buttons (« ‹ › » Ahora) fade in on hover or
   *  focus from `sm` on a pointer that hovers, and below `sm` they, "Ver
   *  10 días" and the rail show with the Controles panel. Only /mapa. */
  compactChrome?: boolean;
}

interface Props {
  /** Unique DOM id for the map container; the rest of the IDs are
   *  derived from this so two instances on one page don't collide.
   *  Use "map" for /mapa to preserve e2e selectors. */
  mapId?: string;
  /** Container height (CSS length, e.g. "100vh" or "400px"). */
  height?: string;
  initialView?: { lat: number; lng: number; zoom: number };
  /** Layer to activate on first load. Defaults to 'base'.
   *  Set to 'temperature' on the forecast embed so the user sees weather
   *  data near their location without an extra click. */
  initialLayer?: string;
  features?: Features;
  /** When true, parses + writes location.hash. Only /mapa should set this. */
  useHash?: boolean;
  /** When true, exposes window.__map under ?e2e=1. Only /mapa should set this. */
  exposeE2eHook?: boolean;
  /** When false, the map is non-interactive. Defaults true. */
  interactive?: boolean;
  /** When false, no marker popup. Defaults true. */
  markerPopups?: boolean;
  /** When true, an IntersectionObserver defers the maplibre dynamic import
   *  until the map is in viewport. Defaults true for embeds; off for /mapa. */
  lazy?: boolean;
  /** Story 21.2 — start the timeline loop on its own when the map boots
   *  on satellite (last 3 h; not under reduced motion / data saver).
   *  Only /mapa sets this; embeds and layer pages stay static. */
  bootAutoplay?: boolean;
  /** Story 21.3 — prefetch the next satellite/radar frames while the
   *  timeline plays (4 MB window; off under data saver). Full-page maps
   *  only: the home embed never sets it. */
  framePrefetch?: boolean;
  /** Tailwind classes for the outer wrapper. */
  class?: string;
  /** Top offset of the layer rail (CSS length). /mapa keeps the default
   *  3.5rem (below its search row); the home overlays its CTA + search
   *  on the map and pushes the rail down past them. */
  railOffsetTop?: string;
  lang?: 'es' | 'en';
}

const {
  mapId = 'map',
  height = '100vh',
  initialView = { lat: 23.6, lng: -102.5, zoom: 4.5 },
  initialLayer,
  // NOTE: this default only applies when the `features` prop is omitted
  // entirely — there is no per-key merge. Every call-site passes an
  // explicit object, so list every flag you want there (see mapa.astro
  // for the "all on" set).
  features = {
    layerRail: true,
    timeline: true,
    search: true,
    locateButton: true,
    presetPins: true,
    backLink: true,
    tools: true,
    settings: true,
    info: true,
    modelToggle: true,
    coords: true,
    legend: true,
  },
  useHash = false,
  exposeE2eHook = false,
  interactive = true,
  markerPopups = true,
  lazy = true,
  bootAutoplay = false,
  framePrefetch = false,
  class: className = '',
  lang = 'es' as const,
  railOffsetTop = '3.5rem',
} = Astro.props;

const t = ui[lang];
const base = import.meta.env.BASE_URL;
// Story 22.3 — tools, settings and info share one "⋯" menu.
const toolsMenu = !!(features.tools || features.settings || features.info);

// Derived IDs — let two instances coexist on one page.
const ids = {
  root: `${mapId}-root`,
  q: mapId === 'map' ? 'mapq' : `${mapId}-q`,
  ac: mapId === 'map' ? 'mapac' : `${mapId}-ac`,
  loc: mapId === 'map' ? 'maploc' : `${mapId}-loc`,
  layerBtns: mapId === 'map' ? 'layerbtns' : `${mapId}-layerbtns`,
  overlayBtns: mapId === 'map' ? 'layerbtns-overlays' : `${mapId}-layerbtns-overlays`,
  overlaysPanel: mapId === 'map' ? 'mw-overlays' : `${mapId}-mw-overlays`,
  // Story 22.2 — compact rail: tabs, active-layer block, overlay filter.
  layersTab: mapId === 'map' ? 'mw-layers-tab' : `${mapId}-mw-layers-tab`,
  layersPanel: mapId === 'map' ? 'mw-layers' : `${mapId}-mw-layers`,
  overlaysTab: mapId === 'map' ? 'mw-overlays-tab' : `${mapId}-mw-overlays-tab`,
  overlayCount: mapId === 'map' ? 'mw-overlays-count' : `${mapId}-mw-overlays-count`,
  overlayFilter: mapId === 'map' ? 'mw-overlays-filter' : `${mapId}-mw-overlays-filter`,
  railActive: mapId === 'map' ? 'mw-rail-active' : `${mapId}-mw-rail-active`,
  subOptions: mapId === 'map' ? 'mw-sub-options' : `${mapId}-mw-sub-options`,
  controlsToggle: mapId === 'map' ? 'mw-controls-toggle' : `${mapId}-controls-toggle`,
  opacityWrap: mapId === 'map' ? 'opacitywrap' : `${mapId}-opacitywrap`,
  opacity: mapId === 'map' ? 'opacity' : `${mapId}-opacity`,
  legend: mapId === 'map' ? 'legend' : `${mapId}-legend`,
  msg: mapId === 'map' ? 'mapmsg' : `${mapId}-msg`,
  tooltip: mapId === 'map' ? 'mapTooltip' : `${mapId}-tooltip`,
  placeCard: mapId === 'map' ? 'mw-place-card' : `${mapId}-place-card`,
  coords: mapId === 'map' ? 'mapCoords' : `${mapId}-coords`,
  timeline: mapId === 'map' ? 'timeline' : `${mapId}-timeline`,
  tlPrev: mapId === 'map' ? 'tl-prev' : `${mapId}-tl-prev`,
  tlPlay: mapId === 'map' ? 'tl-play' : `${mapId}-tl-play`,
  tlNext: mapId === 'map' ? 'tl-next' : `${mapId}-tl-next`,
  tlRange: mapId === 'map' ? 'tl-range' : `${mapId}-tl-range`,
  tlTime: mapId === 'map' ? 'tl-time' : `${mapId}-tl-time`,
  tlBar: mapId === 'map' ? 'tl-bar' : `${mapId}-tl-bar`,
};

// Serialise config for the inline bootstrap script.
const cfg = JSON.stringify({
  mapId,
  ids,
  initialView,
  initialLayer,
  features,
  useHash,
  exposeE2eHook,
  interactive,
  markerPopups,
  lazy,
  bootAutoplay,
  framePrefetch,
  lang,
});
---

<div
  id={ids.root}
  class:list={[
    // group/chrome: lets the mobile-controls trigger (Story 11.3) reveal
    // controls that are absolutely-positioned siblings of the rail, not
    // just its children, via group-data-[controls=open]/chrome variants.
    'im-root group/chrome relative w-full overflow-hidden bg-gray-100 dark:bg-gray-950',
    // Story 23.4 — below sm the timeline is a full-width dock at the
    // bottom; global.css sets --im-dock (its height) for what floats
    // above it (Controles, legend, messages, MapLibre corners).
    features.timeline && 'im-docked',
    className,
  ]}
  style={`height:${height};--im-rail-top:${railOffsetTop};`}
  data-im-config={cfg}
  data-compact={features.compactChrome ? '' : undefined}
>
  {/* Story 19.2 — first-visit welcome card (non-modal; the map stays
      usable). Hidden until interactive-map.ts confirms the browser has
      not seen it before, so a second visit never flashes it. */}
  {features.welcome && (
    <div
      id="mw-welcome"
      role="dialog"
      aria-labelledby="mw-welcome-title"
      aria-describedby="mw-welcome-body"
      hidden
      class="absolute left-1/2 top-3 z-30 w-[min(22rem,calc(100vw-1.5rem))] -translate-x-1/2 rounded-lg border border-gray-200 bg-white/95 p-3 text-sm text-gray-800 shadow-xl backdrop-blur dark:border-gray-700 dark:bg-gray-900/95 dark:text-gray-100"
    >
      <p id="mw-welcome-title" class="font-semibold" data-i18n-en={ui.en.welcome_title}>{t.welcome_title}</p>
      <p id="mw-welcome-body" class="mt-1 text-xs text-gray-600 dark:text-gray-300" data-i18n-en={ui.en.welcome_body}>{t.welcome_body}</p>
      <div class="mt-2 flex gap-2">
        <button
          id="mw-welcome-locate"
          type="button"
          class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3 text-sm font-medium text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
          data-i18n-en={ui.en.welcome_locate}
        >{t.welcome_locate}</button>
        <button
          id="mw-welcome-dismiss"
          type="button"
          class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-gray-300 px-3 text-sm font-medium hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 dark:border-gray-600 dark:hover:bg-gray-800"
          data-i18n-en={ui.en.welcome_dismiss}
        >{t.welcome_dismiss}</button>
      </div>
    </div>
  )}
  {/* Story 22.3 — "Volver al inicio" lives at the top of the ⋯ menu's
      Info tab (below) instead of floating over the map; this overlay only
      remains for a consumer that asks for the link without the Info tab. */}
  {features.backLink && !features.info && (
    <a
      href={base}
      class="absolute left-3 top-3 z-10 inline-flex min-h-[44px] items-center gap-1.5 rounded-full bg-gray-900/80 px-3 text-xs font-medium text-white shadow-lg backdrop-blur-sm hover:bg-gray-900/95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
      ><svg class="h-4 w-4" aria-hidden="true"><use href="#i-arrow-left"></use></svg> {t.back_home}</a
    >
  )}
  {/* Snapshot compare overlay (plan 3.3). Holds the captured canvas
      as an <img> stretched to the map. Hidden until populated. */}
  <img
    id="mw-snapshot-img"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-0 z-[5] hidden h-full w-full opacity-50 mix-blend-multiply dark:mix-blend-screen"
  />

  {features.search && (
    <div id="mw-search-wrap" class="absolute right-3 top-3 z-[21] flex flex-col items-end gap-2">
      <div class="flex items-center gap-2">
        {/* Story 22.4 — page-owned controls that belong in the top bar,
            left of search (/mapa's SMN avisos counter and its popover).
            A popover placed here with `absolute right-0 top-14` hangs
            from #mw-search-wrap's right edge, under the row. */}
        <slot name="topbar" />
        {/* Search icon — click expands the input (plan P1.7). */}
        <button
          id="mw-search-toggle"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-gray-900/80 text-white shadow-lg backdrop-blur-sm hover:bg-gray-900/95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
          aria-label={t.map_search_placeholder}
          aria-expanded="false"
          aria-controls={ids.q}
          title={t.map_search_placeholder}
        ><svg class="h-5 w-5" aria-hidden="true"><use href="#i-search"></use></svg></button>
        <input
          id={ids.q}
          type="text"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls={ids.ac}
          aria-autocomplete="list"
          aria-label={t.map_search_placeholder}
          placeholder={t.map_search_placeholder}
          class="hidden w-72 max-w-[calc(100vw-6rem)] rounded-lg border border-gray-300 bg-white/95 px-3 py-1.5 text-sm text-gray-900 shadow focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-900/95 dark:text-gray-100"
        />
        {features.locateButton && (
          <button
            id={ids.loc}
            type="button"
            class="flex h-11 w-11 items-center justify-center rounded-full bg-gray-900/80 text-white shadow-lg backdrop-blur-sm hover:bg-gray-900/95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
            aria-label={t.map_locate}
            title={t.map_locate}
          ><svg class="h-5 w-5" aria-hidden="true"><use href="#i-locate"></use></svg></button>
        )}
      </div>
      <ul
        id={ids.ac}
        role="listbox"
        class="hidden w-72 max-w-[calc(100vw-1.5rem)] overflow-hidden rounded-lg border border-gray-300 bg-white/95 text-start shadow dark:border-gray-700 dark:bg-gray-900/95"
      ></ul>
    </div>
  )}

  {/* Story 21.1 — `im-chrome dark`: dark translucent panel in both themes
      (tokens in global.css); the `dark` class makes the rows' `dark:`
      utilities apply on the dark panel under the light theme too.

      Story 22.2 — compact rail with progressive disclosure: two tabs
      (Capas / Superposiciones, wired by src/lib/map/chrome/rail-tabs.ts);
      the layers tab is a grid of icon + short-label tiles (3 columns from
      sm, a column of icons below it) and the active layer's block — its
      sub-options and the opacity control — is moved by interactive-map.ts
      right under the grid row of the active tile. The overlays tab keeps
      the old accordion's ids (#mw-overlays, #layerbtns-overlays) and adds
      a filter plus the four most used overlays pinned first. Below sm the
      tab bar and the active block only show with the Controles panel open
      (Story 11.3), as the opacity slider and the accordion did. */}
  {features.layerRail && (
    <div
      class:list={[
        'im-rail group/rail im-chrome dark absolute left-3 top-[var(--im-rail-top)] z-10 w-auto sm:w-52 max-w-[calc(100vw-1.5rem)] max-h-[min(70vh,calc(100%-var(--im-rail-top)-var(--im-dock,0px)-4.25rem))] max-sm:group-data-[legend]/chrome:max-h-[min(70vh,calc(100%-var(--im-rail-top)-var(--im-dock,0px)-7.5rem))] overflow-y-auto sm:max-h-none sm:overflow-visible space-y-2 rounded-lg p-2 sm:p-2.5 text-sm shadow backdrop-blur-sm',
        /* Story 22.5 — folded to its tab bar the rail sizes to the tabs
           (the layers tab also names the active layer); below sm it
           shows with the Controles panel only. */
        features.compactChrome &&
          'sm:data-[rail-open=false]:w-auto max-sm:hidden max-sm:group-data-[controls=open]/chrome:block',
      ]}
      aria-label={t.map_layers}
      role="group"
      data-rail-tab="layers"
      data-rail-collapsible={features.compactChrome ? '' : undefined}
      data-rail-open={features.compactChrome ? 'false' : undefined}
    >
      <div
        role="tablist"
        aria-label={t.map_layers}
        class="hidden group-data-[controls=open]/chrome:flex sm:flex gap-1 rounded-md bg-white/5 p-0.5 text-[11px] font-semibold group-data-[rail-open=false]/rail:mb-0"
      >
        <button
          id={ids.layersTab}
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls={ids.layersPanel}
          aria-expanded={features.compactChrome ? 'false' : undefined}
          data-rail-tab-btn="layers"
          class="inline-flex flex-1 items-center justify-center gap-1 rounded px-2 py-1 text-gray-300 hover:bg-white/10 aria-selected:bg-white/15 aria-selected:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 max-sm:min-h-[44px]"
        ><span data-i18n-en={ui.en.map_layers}>{t.map_layers}</span>{features.compactChrome && (
            /* Story 22.5 — the active layer's short name while the rail is
               collapsed (filled by interactive-map.ts). */
            <span
              data-rail-current
              class="hidden max-w-[5.5rem] truncate font-normal text-blue-200 group-data-[rail-open=false]/rail:inline"
            ></span>
          )}</button>
        <button
          id={ids.overlaysTab}
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls={ids.overlaysPanel}
          aria-expanded={features.compactChrome ? 'false' : undefined}
          tabindex="-1"
          data-rail-tab-btn="overlays"
          class="inline-flex flex-[2] items-center justify-center gap-1 rounded px-2 py-1 text-gray-300 hover:bg-white/10 aria-selected:bg-white/15 aria-selected:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 max-sm:min-h-[44px]"
        ><span data-i18n-en={ui.en.map_overlays}>{t.map_overlays}</span><span
            id={ids.overlayCount}
            hidden
            class="min-w-[1rem] rounded-full bg-blue-500/80 px-1 text-[10px] leading-4 text-white"
          ></span></button>
      </div>
      <div
        id={ids.layersPanel}
        role="tabpanel"
        aria-labelledby={ids.layersTab}
        hidden={features.compactChrome}
      >
        <div id={ids.layerBtns} class="flex flex-col gap-1 sm:grid sm:grid-cols-3">
          {/* Active layer block: interactive-map.ts appends the tiles
              before it, then moves it after the active tile's row and
              hides it on the base map (nothing to vary or fade there). */}
          <div
            id={ids.railActive}
            data-rail-active
            hidden
            class:list={[
              'im-reveal col-span-full flex flex-col gap-1.5 rounded-md bg-white/5 p-1.5',
              features.mobileControls &&
                'max-sm:hidden max-sm:group-data-[controls=open]/chrome:flex',
            ]}
          >
            <div
              id={ids.subOptions}
              class:list={[!features.mobileControls && 'max-sm:hidden']}
            ></div>
            <div id={ids.opacityWrap} class="flex items-center gap-2">
              <label for={ids.opacity} class="shrink-0 text-[11px] text-gray-600 dark:text-gray-400"
                >{t.map_opacity}</label
              >
              <input
                id={ids.opacity}
                type="range"
                min="0"
                max="100"
                value="80"
                class="min-w-0 flex-1 accent-blue-600"
              />
            </div>
          </div>
        </div>
      </div>
      <div
        id={ids.overlaysPanel}
        role="tabpanel"
        aria-labelledby={ids.overlaysTab}
        hidden
        class="space-y-2 text-xs max-sm:w-60"
      >
        <input
          id={ids.overlayFilter}
          type="search"
          autocomplete="off"
          aria-label={t.map_overlays_filter}
          placeholder={t.map_overlays_filter}
          class="w-full rounded-md border border-white/10 bg-white/5 px-2 py-1 text-xs text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 max-sm:min-h-[44px]"
        />
        <div
          id={`${ids.layerBtns}-overlays`}
          class="flex max-h-[min(50vh,22rem)] flex-col gap-1 overflow-y-auto pr-1"
        ></div>
      </div>
    </div>
  )}

  <p
    id={ids.msg}
    aria-live="polite"
    class="absolute bottom-[calc(var(--im-dock,0px)+4.25rem)] left-1/2 z-10 hidden -translate-x-1/2 rounded-lg sm:bottom-32 bg-white/95 px-3 py-1.5 text-xs text-gray-700 shadow dark:bg-gray-900/95 dark:text-gray-300"
  >
  </p>

  {/* Mobile controls trigger (Story 11.3). Below sm, the rail's tab bar
      and active-layer block (Story 22.2) and the model toggle are all
      `hidden sm:*`, i.e. unreachable on a phone (the measure/snapshot
      tools it also used to reveal live in the ⋯ menu since Story 22.3). This reveals them in
      place via data-controls on the map root — no DOM moves, since every
      one of those controls is wired by id from interactive-map.ts and
      three of them are absolutely-positioned siblings of the rail.
      Sits *above* the timeline, not beside it: below sm the timeline is a
      full-width dock (Story 23.4), so the trigger floats --im-dock (the
      dock's height, global.css) + 0.75rem off the bottom — above the
      legend (which hugs the dock) while a layer shows one. */}
  {features.mobileControls && (
    <button
      id={ids.controlsToggle}
      type="button"
      aria-expanded="false"
      aria-label={features.compactChrome ? t.map_controls_compact : 'Controles del mapa'}
      data-i18n-en-aria-label={features.compactChrome ? ui.en.map_controls_compact : 'Map controls'}
      title={features.compactChrome ? t.map_controls_compact : 'Controles del mapa'}
      data-i18n-en-title={features.compactChrome ? ui.en.map_controls_compact : 'Map controls'}
      class="absolute bottom-[calc(var(--im-dock,0px)+0.75rem)] max-sm:group-data-[legend]/chrome:bottom-[calc(var(--im-dock,0px)+4rem)] left-3 z-30 flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-gray-900/85 text-base text-white shadow-lg backdrop-blur-sm aria-expanded:bg-blue-600/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 sm:hidden"
      ><svg class="h-5 w-5" aria-hidden="true"><use href={features.compactChrome ? '#i-layers' : '#i-sliders'}></use></svg></button
    >
  )}

  {features.timeline && (
    <div
      id={ids.timeline}
      class="im-timeline im-chrome dark absolute bottom-0 left-0 right-0 z-30 grid grid-cols-[minmax(0,1fr)_auto] items-center rounded-t-2xl px-2 pt-1 text-sm shadow-lg backdrop-blur-sm sm:bottom-3 sm:left-1/2 sm:right-auto sm:w-max sm:max-w-[calc(100vw-1.5rem)] sm:-translate-x-1/2 sm:gap-x-1 sm:rounded-2xl sm:px-4 sm:pb-1.5 sm:pt-2"
      role="group"
      aria-label={t.timeline_label}
    >
      {/* Story 23.1 — from `sm` the pill is two rows: the date-scale bar
          (+ the dotted "Ver 10 días" tail) on top, the buttons and the
          label below. Story 23.4 — below `sm` it is a full-width dock
          glued to the bottom edge: the buttons and the label on top, the
          bar (56 px tall, the thumb's scrubbing strip) + its tail at the
          very bottom. Ids unchanged: the buttons only moved into this row
          wrapper. */}
      <div class="tl-controls col-span-2 row-start-1 flex min-h-[44px] items-center justify-center gap-1 sm:row-start-2 sm:gap-2">
        <button
          id={ids.tlPlay}
          type="button"
          aria-label={t.timeline_play}
          aria-pressed="false"
          disabled
          class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full bg-white/10 px-2.5 text-base leading-none hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 disabled:opacity-40"
          ><svg class="h-4 w-4" aria-hidden="true"><use href="#i-play"></use></svg></button
        >
        {/* « » are desktop steps (`hidden` until the axis spans days, then
            `sm:inline-flex`). Story 23.4 — `max-sm:hidden` keeps them off
            a phone once interactive-map.ts drops `hidden`: the dock's row
