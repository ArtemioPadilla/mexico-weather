  )}

  {/*
    Forecast model badge bottom-right, zoom.earth-style "ICON 13 km".
    Open-Meteo's bulk endpoint uses 'best_match' which selects the
    highest-resolution model per location (ECMWF in MX = ~9 km, ICON
    ~13 km global fallback). Static label; no JS needed.
  */}
  {features.modelToggle && (
    <div
      id="mw-model-toggle"
      class="absolute bottom-9 max-sm:group-data-[controls=open]/chrome:bottom-[4.5rem] right-2 z-10 hidden items-center gap-1 rounded-full bg-gray-900/80 px-1 py-0.5 text-[10px] font-mono tabular-nums text-gray-300 backdrop-blur-sm group-data-[controls=open]/chrome:inline-flex sm:inline-flex"
      aria-label="Modelo de pronóstico Open-Meteo"
    >
      {[
        { id: 'best_match', label: 'Auto' },
        { id: 'icon_seamless', label: 'ICON' },
        { id: 'gfs_seamless', label: 'GFS' },
        { id: 'ecmwf_ifs04', label: 'ECMWF' },
        { id: 'jma_seamless', label: 'JMA' },
      ].map((m) => (
        /* 24px floor, not 44: five 44px segments would make this corner
           pill ~220px wide over the map. WCAG 2.5.8 AA (24x24) plus the
           spacing exemption is the right target for a segmented control.
           Desktop-only today (the wrapper is hidden sm:inline-flex). */
        <button
          type="button"
          data-model={m.id}
          aria-pressed={m.id === 'best_match' ? 'true' : 'false'}
