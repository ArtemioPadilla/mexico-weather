{/*
 * Popup contrast fix (issue #71), themed by the --im-* tokens since
 * Story 25.2. Declared here once and shared across all map instances on
 * the page.
 */}
<style is:global>
  /*
   * Map zoom (NavigationControl) sits at bottom-left after PR #117 to dodge
   * the feedback FAB (bottom-right). On embeds (forecast 320px, home 400px)
   * the bottom-left corner is the very edge of the embed and on /mapa the
   * timeline scrubber sits at bottom-center — the +/- buttons were
   * touching / clipping the viewport edge. Bump them up so they sit clear
   * of the timeline AND have breathing room at the embed bottom.
   */
  .maplibregl-ctrl-bottom-left {
    bottom: 72px !important;
    left: 12px !important;
  }
  /* Story 23.4 — below sm the timeline is a full-width dock (--im-dock
     tall, global.css): both bottom corners — zoom buttons on the left,
     scale + attribution on the right — sit on top of it, not under it. */
  @media (max-width: 639.98px) {
    .im-docked .maplibregl-ctrl-bottom-left {
      bottom: calc(var(--im-dock) + 0.75rem) !important;
    }
    .im-docked .maplibregl-ctrl-bottom-right {
      bottom: var(--im-dock);
    }
  }
</style>

<script>
  import {
    initInteractiveMap,
    type InteractiveMapFeatures,
  } from '../lib/interactive-map';
  import { wireRailTabs, type RailTabs } from '../lib/map/chrome/rail-tabs';
  import { wireToolsMenu, type ToolsMenu } from '../lib/map/chrome/tools-menu';
  import {
    createBottomSheet,
    sheetStrings,
    type BottomSheet,
  } from '../lib/map/chrome/bottom-sheet';
  import { documentUiLang } from '../i18n/ui';

  // Rail tabs per rail, so the Controles panel can open/collapse a
  // collapsible rail (Story 22.5) through the same state machine.
  const railTabsByRail = new WeakMap<HTMLElement, RailTabs>();

  type ImCfg = {
    mapId: string;
    ids: Record<string, string>;
    initialView: { lat: number; lng: number; zoom: number };
    initialLayer?: string;
    features: InteractiveMapFeatures;
    useHash: boolean;
    exposeE2eHook: boolean;
    interactive: boolean;
    markerPopups: boolean;
    lazy: boolean;
    bootAutoplay?: boolean;
    framePrefetch?: boolean;
    fieldDetail?: boolean;
    lang: 'es' | 'en';
  };

  // Init every map root on the page. Each root carries its own config in a
  // data-attribute so two embeds (e.g. /mapa overlay vs an embed) coexist.
  function bootAll(): void {
    const roots = document.querySelectorAll<HTMLElement>('.im-root[data-im-config]');
    roots.forEach((root) => {
      // Guard against double-init under HMR / view transitions.
      if (root.dataset.imBooted === '1') return;
      root.dataset.imBooted = '1';

      let cfg: ImCfg;
      try {
        cfg = JSON.parse(root.dataset.imConfig || '{}') as ImCfg;
      } catch {
        return;
      }

      const container = document.getElementById(cfg.mapId);
      if (!container) return;

      const boot = (): void => {
        const els = {
          container,
          search: document.getElementById(cfg.ids.q) as HTMLInputElement | null,
          acList: document.getElementById(cfg.ids.ac) as HTMLUListElement | null,
          locate: document.getElementById(cfg.ids.loc),
          layerBtns: document.getElementById(cfg.ids.layerBtns),
          overlayBtns: document.getElementById(cfg.ids.overlayBtns),
          overlayFilter: document.getElementById(cfg.ids.overlayFilter) as HTMLInputElement | null,
          overlayCount: document.getElementById(cfg.ids.overlayCount),
          railActive: document.getElementById(cfg.ids.railActive),
          subOptions: document.getElementById(cfg.ids.subOptions),
          opacityWrap: document.getElementById(cfg.ids.opacityWrap),
          opacity: document.getElementById(cfg.ids.opacity) as HTMLInputElement | null,
          legend: document.getElementById(cfg.ids.legend),
          timeline: document.getElementById(cfg.ids.timeline),
          tlPrev: document.getElementById(cfg.ids.tlPrev),
          tlPlay: document.getElementById(cfg.ids.tlPlay) as HTMLButtonElement | null,
          tlNext: document.getElementById(cfg.ids.tlNext),
          tlRange: document.getElementById(cfg.ids.tlRange) as HTMLInputElement | null,
          tlTime: document.getElementById(cfg.ids.tlTime),
          tlBar: document.getElementById(cfg.ids.tlBar),
          msg: document.getElementById(cfg.ids.msg),
          tooltip: document.getElementById(cfg.ids.tooltip),
          coords: document.getElementById(cfg.ids.coords),
          placeCard: document.getElementById(cfg.ids.placeCard),
        };
        // Surface async init failures. Without these handlers an
        // unhandled rejection inside initInteractiveMap is silently
        // dropped by the FAB's AbortError filter and the map appears
        // to vanish for no reason.
        try {
          initInteractiveMap({
            els,
            features: cfg.features,
            initialView: cfg.initialView,
            initialLayer: cfg.initialLayer,
            useHash: cfg.useHash,
            exposeE2eHook: cfg.exposeE2eHook,
            interactive: cfg.interactive,
            markerPopups: cfg.markerPopups,
            bootAutoplay: cfg.bootAutoplay === true,
            framePrefetch: cfg.framePrefetch === true,
            fieldDetail: cfg.fieldDetail === true,
            lang: cfg.lang,
          }).catch((err) => {
             
            console.error('[interactive-map] init failed:', err);
            // Never leave the Story 21.4 skeleton shimmering over a map
            // that will not come.
            root.classList.add('im-ready');
          });
        } catch (err) {
           
          console.error('[interactive-map] init threw synchronously:', err);
          root.classList.add('im-ready');
        }
      };

      if (cfg.lazy && typeof IntersectionObserver === 'function') {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                obs.disconnect();
                boot();
                return;
              }
            }
          },
          { rootMargin: '200px' },
        );
        io.observe(root);
      } else {
        // /mapa is non-lazy: the whole viewport IS the map. The
        // previous implementation used `requestAnimationFrame(boot)`
        // here, but rAF callbacks are throttled or paused entirely
        // when the tab is backgrounded (browser tab not focused, OS
        // window not focused, screen off, headless / automated
        // sessions, etc.). The result was a silent boot failure:
        // `imBooted` got set so `bootAll` wouldn't retry, the
        // scheduled rAF never fired, and the map never mounted.
        // setTimeout fires even in background tabs (clamped to 1 s
        // minimum but still reliable), and 0 ms is plenty to let
        // the current task finish before mounting. Fixes NEW-C1.
        window.setTimeout(boot, 0);
      }
    });
  }

  // Story 11.3 — mobile controls trigger. Flips data-controls on the map
  // root; the group-data-[controls=open]/chrome:* variants on the hidden
  // controls do the revealing. Pure CSS reveal, no DOM moves.
  function wireMobileControls(): void {
    const toggles = document.querySelectorAll<HTMLButtonElement>(
      'button[id$="controls-toggle"]',
    );
    toggles.forEach((toggle) => {
      const root = toggle.closest('.im-root') as HTMLElement | null;
      if (!root) return;
      // Story 25.1 — below sm the /mapa rail is a bottom sheet: the
      // trigger shows it at half height, a drag down or Escape inside it
      // closes the panel like the trigger does.
      const railEl = root.querySelector<HTMLElement>('.im-rail.im-sheet');
      let sheet: BottomSheet | null = null;
      const setOpen = (open: boolean): void => {
        if (open) root.dataset.controls = 'open';
        else delete root.dataset.controls;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        // Story 22.2 — the tab bar hides with the panel below sm; leave
        // the rail on its layers tab so the layer icons never vanish
        // behind a tab the phone can no longer switch back from.
        // Story 22.5 — a collapsible rail (/mapa) hides with the panel
        // below sm: opening the panel opens it on the layers tab, closing
        // the panel collapses it.
        const rail = root.querySelector<HTMLElement>('.im-rail');
        const tabs = rail ? railTabsByRail.get(rail) : undefined;
        if (rail && tabs && rail.dataset.railCollapsible !== undefined) {
          tabs.select('layers');
          tabs.setOpen(open);
        } else if (!open) {
          root
            .querySelector<HTMLElement>('.im-rail [data-rail-tab-btn="layers"]')
            ?.click();
        }
        if (open) {
          sheet?.show({
            focus: rail?.querySelector<HTMLElement>(
              '[role="tab"][aria-selected="true"]'
            ),
            returnFocus: toggle,
          });
        } else {
          sheet?.hide();
        }
      };
      if (railEl) {
        sheet = createBottomSheet({
          name: 'layers',
          sheet: railEl,
          handle: railEl.querySelector<HTMLElement>('[data-sheet-handle]'),
          root,
          strings: sheetStrings(documentUiLang()),
          onDismiss: () => setOpen(false),
        });
      }
      toggle.addEventListener('click', () => {
        setOpen(root.dataset.controls !== 'open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        // interactive-map.ts binds Escape on the search input and the
        // autocomplete list and calls preventDefault() there; don't
        // double-handle when one of those already consumed the key.
        if (e.defaultPrevented) return;
        if (root.dataset.controls === 'open') setOpen(false);
      });
    });
  }

  // Story 22.2 — Capas / Superposiciones tabs of every rail on the page.
  // Pure DOM, so it runs before (and independently of) the lazy map boot.
  function wireAllRailTabs(): void {
    document.querySelectorAll<HTMLElement>('.im-rail').forEach((rail) => {
      if (rail.dataset.railTabsWired === '1') return;
      rail.dataset.railTabsWired = '1';
      railTabsByRail.set(rail, wireRailTabs(rail));
    });
  }

  // Story 22.3 — the one "⋯ Herramientas" menu (literal ids: only the
  // full-page map renders it). Pure DOM like the rail tabs; wired before
  // the Controles panel so an Escape that closes the menu (and is marked
  // handled) leaves that panel open.
  function wireToolsPopover(): void {
    const button = document.getElementById('mw-tools-btn');
    const panel = document.getElementById('mw-tools-panel');
    if (!button || !panel || button.dataset.toolsWired === '1') return;
    button.dataset.toolsWired = '1';
    // Story 25.1 — below sm the popover is a bottom sheet of the map.
    const root = button.closest<HTMLElement>('.im-root');
    let sheet: BottomSheet | null = null;
    const menu: ToolsMenu = wireToolsMenu({
      button,
      panel,
      onToggle: (open) => {
        if (open) sheet?.show({ returnFocus: button });
        else sheet?.hide();
      },
      // A press on what floats above the sheet (the Controles trigger)
      // must not close it first and move that control from under the
      // finger: its own click swaps the sheets.
      keepOpenOn: (t) =>
        !!sheet?.isActive() &&
        !!(t as Element).closest?.('.im-above-sheet'),
    });
    if (root) {
      sheet = createBottomSheet({
        name: 'tools',
        sheet: panel,
        handle: panel.querySelector<HTMLElement>('[data-sheet-handle]'),
        root,
        strings: sheetStrings(documentUiLang()),
        onDismiss: () => menu.close(true),
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', wireToolsPopover);
    document.addEventListener('DOMContentLoaded', wireMobileControls);
    document.addEventListener('DOMContentLoaded', wireAllRailTabs);
  } else {
    wireToolsPopover();
    wireMobileControls();
    wireAllRailTabs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootAll);
  } else {
    bootAll();
  }
</script>
