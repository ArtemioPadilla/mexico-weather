        <button
          type="button"
          data-shortcuts-close
          aria-label={t.map_shortcuts_close}
          data-i18n-en-aria-label={ui.en.map_shortcuts_close}
          title={t.map_shortcuts_close}
          data-i18n-en-title={ui.en.map_shortcuts_close}
          class="im-btn im-btn-icon"
