    <dialog
      id="mw-shortcuts"
      aria-labelledby="mw-shortcuts-title"
      class="im-chrome im-reveal dark m-auto max-h-[min(85dvh,42rem)] w-[min(44rem,calc(100vw-1.5rem))] overflow-y-auto rounded-im-panel border border-im-border p-4 text-sm shadow-im-raised backdrop:bg-black/50"
