      class="im-chrome dark absolute left-1/2 top-16 z-30 flex max-w-[calc(100vw-8rem)] -translate-x-1/2 items-center gap-2 rounded-full py-0.5 pl-3 pr-0.5 text-xs shadow-lg backdrop-blur-sm sm:top-3 sm:max-w-md"
    >
