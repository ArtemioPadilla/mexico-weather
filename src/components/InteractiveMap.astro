  {/* Story 22.5 — the keyboard cheat-sheet. Filled and wired by
      interactive-map.ts from LAYERS and overlayDefs (shortcuts.ts +
      shortcuts-dialog.ts): `?` or the ⋯ → Info entry opens it; Esc, `?`,
      the close button or the backdrop close it. Modal, so the map's
      letter keys never act behind it. */}
  {toolsMenu && features.layerRail && (
    <dialog
      id="mw-shortcuts"
      aria-labelledby="mw-shortcuts-title"
      class="im-chrome dark m-auto max-h-[min(85dvh,42rem)] w-[min(44rem,calc(100vw-1.5rem))] overflow-y-auto rounded-xl border border-white/10 p-4 text-sm shadow-2xl backdrop:bg-black/50"
    >
      <div class="mb-3 flex items-center justify-between gap-2">
        <h2 id="mw-shortcuts-title" class="text-base font-semibold text-white" data-i18n-en={ui.en.map_shortcuts}>{t.map_shortcuts}</h2>
        <button
          type="button"
          data-shortcuts-close
          aria-label={t.map_shortcuts_close}
          data-i18n-en-aria-label={ui.en.map_shortcuts_close}
          title={t.map_shortcuts_close}
